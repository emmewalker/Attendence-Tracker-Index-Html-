<option value="10th Grade Girls Tech">10th Grade Girls Tech</option>
<option value="8th Grade Class Meeting">8th Grade Class Meeting</option>
<option value="Jazz Band">Jazz Band</option>
<option value="Yearbook">Yearbook</option>
</select>

<label for="student-select">Select Your Name:</label>
<select id="student-select">
<option value="" disabled selected>Choose your name from the roster...</option>
</select>
<button onclick="processCheckIn()">Confirm Present ✔️</button>
</div>

<div class="panel" style="background-color: #fff;">
<div class="panel-title">End of Class Data</div>
<button class="download-btn" onclick="exportToCSV()">📥 Download Attendance Log (.CSV)</button>
</div>
<div class="footer-text">Secure Local Device Storage Active</div>
</div>

