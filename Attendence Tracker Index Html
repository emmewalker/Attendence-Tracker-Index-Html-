h1 { text-align: center; color: #111827; font-size: 24px; margin-bottom: 5px; }
h2 { font-size: 16px; color: #4b5563; font-weight: 500; text-align: center; margin-top: 0; margin-bottom: 25px; }
.panel { background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 8px; padding: 20px; margin-bottom: 20px; }
.panel-title { font-weight: 600; font-size: 14px; color: #374151; margin-bottom: 12px; text-transform: uppercase; letter-spacing: 0.05em; }
label { display: block; margin-bottom: 6px; font-weight: 500; font-size: 14px; color: #4b5563; }
select { width: 100%; padding: 12px; margin-bottom: 15px; border: 1px solid #d1d5db; border-radius: 6px; background-color: white; font-size: 16px; box-sizing: border-box; }
button { width: 100%; background-color: #2563eb; color: white; border: none; padding: 14px; font-size: 16px; font-weight: 600; border-radius: 6px; cursor: pointer; transition: background 0.15s ease; }
button:hover { background-color: #1d4ed8; }
button.admin-btn { background-color: #4b5563; padding: 10px; font-size: 14px; }
button.admin-btn:hover { background-color: #374151; }
button.download-btn { background-color: #059669; margin-top: 15px; }
button.download-btn:hover { background-color: #047857; }
.timer-box { text-align: center; font-size: 15px; font-weight: 600; padding: 10px; border-radius: 6px; margin-top: 10px; background-color: #e5e7eb; color: #374151; }
.timer-active { background-color: #fef3c7; color: #d97706; }
.timer-expired { background-color: #fee2e2; color: #dc2626; }
.footer-text { text-align: center; font-size: 12px; color: #9ca3af; margin-top: 30px; }
</style>
</head>
