let checkedInStudents = []; 
let classStartTime = null;
const FIVE_MINUTES_MS = 5 * 60 * 1000;
let clockInterval = null;

window.onload = function() {
  populateDropdown();
};

function populateDropdown() {
  const classSelect = document.getElementById('class-select');
  const selectedClass = classSelect.value;
  const currentRoster = classRosters[selectedClass] || [];
  
  const select = document.getElementById('student-select');
  select.innerHTML = '<option value="" disabled selected>Choose your name from the roster...</option>';
  
  currentRoster.forEach(student => {
    if (!checkedInStudents.some(record => record.name === student && record.className === selectedClass)) {
      let opt = document.createElement('option');
      opt.value = student;
      opt.textContent = student;
      select.appendChild(opt);
    }
  });
}

function startAttendanceWindow() {
  classStartTime = new Date().getTime();
  if (clockInterval) clearInterval(clockInterval);
  clockInterval = setInterval(updateCountdown, 1000);
  const display = document.getElementById('timer-display');
  display.className = "timer-box timer-active";
  display.textContent = "⏱️ On-Time Window Closing In: 5m 00s";
}

function updateCountdown() {
  const now = new Date().getTime();
  const elapsed = now - classStartTime;
  const remaining = FIVE_MINUTES_MS - elapsed;
  const display = document.getElementById('timer-display');
  if (remaining <= 0) {
    clearInterval(clockInterval);
    display.className = "timer-box timer-expired";
    display.textContent = "⏰ 5 Minutes Passed: Remaining check-ins marked LATE";
  } else {
    const minutes = Math.floor((remaining % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((remaining % (1000 * 60)) / 1000);
    display.textContent = `⏱️ On-Time Window Closing In: ${minutes}m ${seconds}s`;
  }
}

function processCheckIn() {
  const classSelect = document.getElementById('class-select');
  const selectedClass = classSelect.value;
  
  const select = document.getElementById('student-select');
  const selectedStudent = select.value;
  
  if (!selectedStudent) {
    alert("Please highlight your name from the dropdown list before checking in.");
    return;
  }
  const now = new Date();
  let status = "Present";
