<h1>🏫 Class Check-In Portal</h1>
<h2>Attendance Tracker System</h2>

<div class="panel">
<div class="panel-title">Teacher Controls</div>
<button class="admin-btn" onclick="startAttendanceWindow()">⏱️ Start 5-Minute Class Clock</button>
<div class="timer-box" id="timer-display">Clock Status: Ready to Start</div>
</div>

<div class="panel">
<div class="panel-title">Student Check-In</div>
<label for="class-select">Select Your Class:</label>
<select id="class-select" onchange="populateDropdown()">
<option value="Boys Band" selected>Boys Band</option>
<option value="Girls Band">Girls Band</option>
<option value="Earth Science">Earth Science</option>
<option value="Intermediate Band">Intermediate Band</option>
<option value="7th Grade Boys Tech">7th Grade Boys Tech</option>
